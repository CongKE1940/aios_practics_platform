# Copy this file to /mnt/user/stacks/aios/.env on Unraid and edit values there.
# Do not commit real passwords or secrets.

TZ=Asia/Shanghai
AIOS_APP_ENV=prod
AIOS_VERSION=latest

# Images built by .github/workflows/docker-publish.yml
AIOS_API_IMAGE=ghcr.io/congke1940/aios-api
AIOS_ADMIN_WEB_IMAGE=ghcr.io/congke1940/aios-admin-web
AIOS_USER_WEB_IMAGE=ghcr.io/congke1940/aios-user-web

# Static IPs in the Unraid br0 network.
MYSQL_IP=192.168.1.130
REDIS_IP=192.168.1.131
AIOS_API_IP=192.168.1.132
AIOS_ADMIN_WEB_IP=192.168.1.133
AIOS_USER_WEB_IP=192.168.1.134
MINIO_IP=192.168.1.135

MYSQL_PORT=3306
REDIS_PORT=6379
AIOS_API_PORT=18081
AIOS_ADMIN_WEB_PORT=18082
AIOS_USER_WEB_PORT=18083
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MySQL. Fill in the real values only on Unraid.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=aios
MYSQL_USER=congke
MYSQL_PASSWORD=CHANGE_ME_USER_PASSWORD

# Redis.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# MinIO object storage.
# MINIO_ROOT_USER must be at least 3 characters.
# MINIO_ROOT_PASSWORD must be at least 8 characters.
MINIO_ROOT_USER=aios_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=aios-assets
MINIO_REGION=us-east-1
MINIO_SERVER_URL=http://192.168.1.135:9000
MINIO_BROWSER_REDIRECT_URL=http://192.168.1.135:9001
MINIO_PUBLIC_ENDPOINT=http://192.168.1.135:9000

# API.
AIOS_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
AIOS_PLATFORM_TENANT_ID=1

# Used only by deploy/unraid/backup.sh.
AIOS_MYSQL_HOST=192.168.1.130
AIOS_MYSQL_PORT=3306
AIOS_MYSQL_DATABASE=aios
AIOS_MYSQL_USER=congke
AIOS_MYSQL_PASSWORD=CHANGE_ME_USER_PASSWORD
